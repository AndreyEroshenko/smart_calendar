# Copy to .env and fill in. .env is git-ignored and pushed to the server by `./deploy.sh --secrets`.
TELEGRAM_BOT_TOKEN=123456:ABC...
ANTHROPIC_API_KEY=sk-ant-...
# Comma-separated Telegram user IDs allowed to use the bot (send /start to the bot to see yours).
ALLOWED_TELEGRAM_USER_IDS=111111111,222222222
# Target calendar ID (Google Calendar → Settings → your "Family" calendar → Integrate calendar).
GOOGLE_CALENDAR_ID=primary
# Home timezone, used to resolve "next Saturday at 6".
TIMEZONE=Australia/Melbourne
# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# DATA_DIR=/data
